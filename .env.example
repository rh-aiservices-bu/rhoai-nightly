# Copy this file to .env and fill in your values
# .env is gitignored and will not be committed

# =============================================================================
# Pull Secret Configuration (choose ONE option)
# =============================================================================
#
# Option A: Manual credentials (set both QUAY_USER and QUAY_TOKEN)
#   - Directly patches the cluster pull-secret with your credentials
#   - Use if you have personal quay.io/rhoai access
#
# Option B: External Secrets (leave QUAY vars empty, ensure bootstrap repo access)
#   - Uses External Secrets Operator to sync from AWS Secrets Manager
#   - Requires git access to the private bootstrap repo
#   - Override BOOTSTRAP_REPO/BOOTSTRAP_BRANCH if using a fork
#
# If both are set, Option A (manual) takes precedence.
# =============================================================================

# Option A: Manual quay.io credentials
QUAY_USER=
QUAY_TOKEN=

# Option B: Bootstrap repo for External Secrets (defaults shown)
# BOOTSTRAP_REPO=https://github.com/rh-aiservices-bu/rh-aiservices-bu-bootstrap.git
# BOOTSTRAP_BRANCH=dev

# =============================================================================
# Let's Encrypt (Route53 DNS-01 credentials)
# Consumed by `make le-creds`, which creates the letsencrypt-route53-credentials
# Secret in ns cert-manager for the letsencrypt-prod ClusterIssuer.
# IAM user needs route53:GetChange + route53:ChangeResourceRecordSets on the
# nightly.rhai-tmm.dev zone (plus route53:GetHostedZone for zone discovery).
# =============================================================================
LE_AWS_ACCESS_KEY_ID=
LE_AWS_SECRET_ACCESS_KEY=

# =============================================================================
# Keycloak (identity provider)
# Consumed by `make keycloak` (scripts/install-keycloak.sh), which deploys the
# keycloak + keycloak-auth OCI charts as script-created ArgoCD Applications —
# these values are injected there and never committed to git. Any variable
# left empty is auto-generated on first `make keycloak` and appended to .env.
#   WILDCARD_DOMAIN           cluster wildcard domain (auto-detected from the
#                             ingress config when empty)
#   EMAIL_DOMAIN              realm-user email domain (defaults to
#                             WILDCARD_DOMAIN minus the leading "apps.")
#   KEYCLOAK_ADMIN_PASSWORD   realm sso admin (user keycloak-admin)
#   KEYCLOAK_TEST_PASSWORD    test users alice/bob
#   KEYCLOAK_OCP_IDP_SECRET   ocp-idp client secret (shared with the OAuth IdP)
#   KEYCLOAK_MAAS_API_SECRET  maas-api client secret (AITenant issuer)
#   KEYCLOAK_PORTAL_SECRET    maas-consumer-portal client secret
# =============================================================================
WILDCARD_DOMAIN=
EMAIL_DOMAIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_TEST_PASSWORD=
KEYCLOAK_OCP_IDP_SECRET=
KEYCLOAK_MAAS_API_SECRET=
KEYCLOAK_PORTAL_SECRET=

# MaaS consumer portal cookie secret for the portal auth-proxy — auto-generated
# by `make maas-portal-creds` on first run; leave empty.
MAAS_PORTAL_COOKIE_SECRET=

# =============================================================================
# GPU MachineSet Configuration (optional - defaults shown)
# Autoscaling: MIN/MAX control cluster autoscaler, replicas starts at MIN
# =============================================================================
# GPU_INSTANCE_TYPE=g6e.2xlarge
# GPU_ACCESS_TYPE=SHARED
# GPU_AZ=
# GPU_MIN=1
# GPU_MAX=3

# =============================================================================
# CPU Worker MachineSet Configuration (optional - defaults shown)
# Creates dedicated CPU worker nodes separate from master/infra
# Autoscaling: MIN/MAX control cluster autoscaler, replicas starts at MIN
# =============================================================================
# CPU_INSTANCE_TYPE=m6a.4xlarge
# CPU_AZ=
# CPU_VOLUME_SIZE=120
# CPU_MIN=1
# CPU_MAX=3

# =============================================================================
# NFS Provisioner Configuration (for RWX PVC support)
# Deploys via GitOps - NFS server backed by gp3-csi EBS.
# Size and backing StorageClass are NOT env-configurable; they are set
# declaratively in components/instances/nfs-instance/base/nfsprovisioner.yaml
# (spec.storageSize, spec.scForNFSPvc). Edit that file to change them.
# =============================================================================

# =============================================================================
# GitOps Configuration (optional - for forks/testing)
# =============================================================================
# GITOPS_REPO_URL=https://github.com/rh-aiservices-bu/rhoai-nightly
# GITOPS_BRANCH=main
#
# Apps to skip in make sync (space-separated ArgoCD app names); skipped apps
# keep their current sync policy. Leave commented to sync everything.
# SYNC_SKIP_APPS=app-one app-two
#
# =============================================================================
# MaaS Models (optional - space-separated list of models to deploy)
# Available: simulator, gpt-oss-20b, granite-tiny-gpu, auto (default), all
# Default 'auto' inspects the cluster and picks: no GPU -> simulator;
# GPU VRAM >= 40 GiB -> gpt-oss-20b; otherwise -> granite-tiny-gpu.
# =============================================================================
# MAAS_MODELS=auto
# MAAS_MODELS=gpt-oss-20b granite-tiny-gpu

# =============================================================================
# RHOAI Version
# =============================================================================
# To change RHOAI version, edit:
#   components/operators/rhoai-operator/base/catalogsource.yaml  (image)
# Examples:
#   - quay.io/rhoai/rhoai-fbc-fragment:rhoai-3.4-ea.1-nightly
#   - quay.io/rhoai/rhoai-fbc-fragment:rhoai-3.4-ea.2-nightly
